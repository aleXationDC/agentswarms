admin.matrix.alexation.com {
    @trusted {
        remote_ip 127.0.0.1/8 100.64.0.0/10
        not path /_axtn/extension-access/*
    }
    handle @trusted {
        reverse_proxy 127.0.0.1:8082
    }

    import axtn_extension_access_v1 matrix-admin \
        "https://admin.matrix.alexation.com/" \
        "127.0.0.1:18080" \
        "127.0.0.1:8082"
}
